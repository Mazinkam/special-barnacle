{
  "schema_version": 3,
  "orchestration": {
    "strategy": "hierarchical",
    "max_depth": 4,
    "max_parallel_workers": 8,
    "max_workers_per_lead": 5,
    "worker_retry_limit": 2,
    "stop_loss_multiplier": 3.0,
    "review_queue_soft_limit": 8
  },
  "optimization": {
    "quality_floor": 0.95,
    "cost_aggressiveness": 0.7,
    "latency_weight": 0.1,
    "human_hour_value_usd": 0.0,
    "risk_quality_floor_delta": {
      "low": 0.0,
      "medium": 0.02,
      "high": 0.04,
      "critical": 0.045
    },
    "hard_gates": {
      "acceptance_criteria_must_pass": true,
      "tests_must_pass_when_applicable": true,
      "no_unresolved_high_risk_findings": true
    }
  },
  "context": {
    "default_worker_budget_tokens": 18000,
    "lead_budget_tokens": 36000,
    "architect_budget_tokens": 50000,
    "packet_refetch_threshold": 0.12,
    "invalidate_on_revision_change": true
  },
  "verification": {
    "default_depth": "targeted",
    "cache_enabled": true,
    "flaky_window": 30,
    "flaky_threshold": 0.2
  },
  "history": {
    "min_samples_for_empirical_route": 12,
    "confidence_penalty_small_sample": 0.05,
    "complexity_bucket_width": 2,
    "decay_half_life_days": 60,
    "use_cross_repo_history": false
  },
  "pricing": {
    "enabled": true,
    "units": "usd_per_million_tokens",
    "note": "Used only when a runtime reports tokens but cannot report cost_usd. Keys match by longest substring, so 'us.anthropic.claude-sonnet-5' resolves to 'claude-sonnet-5'. Unlisted models stay unmetered rather than being priced by guess. Rates below were read from the local HUMAIN Terminal model catalog (~/.humain-terminal/agent/models-store.json) and must be refreshed from the provider of record; treat every derived figure as an estimate.",
    "models": {
      "claude-haiku-4-5": {
        "input_per_mtok": 1.0,
        "output_per_mtok": 5.0,
        "cache_read_per_mtok": 0.1,
        "cache_write_per_mtok": 1.25
      },
      "claude-sonnet-4-5": {
        "input_per_mtok": 3.0,
        "output_per_mtok": 15.0,
        "cache_read_per_mtok": 0.3,
        "cache_write_per_mtok": 3.75
      },
      "claude-sonnet-5": {
        "input_per_mtok": 2.0,
