  },
  "budgets": {
    "default_task_usd": 0.5,
    "high_risk_task_usd": 3.0,
    "critical_task_usd": null
  },
  "features": {
    "adaptive_system": {
      "enabled": true
    },
    "adaptive_routing": {
      "mode": "recommend",
      "allow_model_switching": true,
      "allow_effort_switching": true,
      "allow_topology_changes": true,
      "allow_context_budget_changes": true,
      "allow_verification_changes": true
    },
    "historical_learning": {
      "enabled": true,
      "minimum_samples": 12,
      "decay_old_results": true,
      "decay_half_life_days": 60,
      "use_cross_repo_history": false
    },
    "exploration": {
      "enabled": true,
      "rate": 0.02,
      "max_extra_cost_percent": 10.0,
      "exclude_high_risk_tasks": true
    },
    "shadow_routing": {
      "enabled": true,
      "estimate_only": true,
      "execute_alternative": false,
      "sampling_rate": 0.05
    },
    "model_promotion": {
      "enabled": true,
      "after_conceptual_failures": 1,
      "after_mechanical_failures": 2
    },
    "model_demotion": {
      "enabled": true
    },
    "effort_adaptation": {
      "enabled": true,
      "allow_increase": true,
      "allow_decrease": true,
      "max_effort": "high"
    },
    "dynamic_depth": {
      "enabled": true,
      "max_depth": 4
    },
    "dynamic_parallelism": {
      "enabled": true,
      "min_workers": 1,
      "max_workers": 8,
      "use_backpressure": true
    },
    "subleads": {
      "enabled": true,
      "minimum_complexity": 8.0
    },
    "task_fusion": {
      "enabled": true
    },
    "task_splitting": {
      "enabled": true
    },
    "context_optimization": {
      "enabled": true,
      "adaptive_budget": true,
      "deduplicate_context": true,
      "lazy_load_context": true
    },
    "repo_map": {
      "enabled": true,
      "reuse": true,
      "auto_invalidate": true
    },
    "shared_discoveries": {
      "enabled": true
    },
    "persistent_leads": {
      "enabled": true,
      "reuse_across_runs": true
    },
    "deterministic_verification": {
      "formatter": "on",
      "lint": "on",
      "typecheck": "on",
      "unit_tests": "on",
      "integration_tests": "adaptive",
      "full_test_suite": "adaptive"
    },
    "verification_cache": {
      "enabled": true,
      "require_exact_revision": true
    },
    "flaky_test_detection": {
      "enabled": true,
      "auto_retry_known_flakes": true,
      "auto_ignore_known_flakes": false
    },
    "semantic_review": {
      "enabled": true,
      "adaptive_depth": true
    },
    "independent_review": {
      "mode": "risk_based"
    },
    "shadow_review": {
      "enabled": true,
      "sample_rate": 0.03
    },
    "specialized_reviews": {
      "security": "adaptive",
      "performance": "adaptive",
      "migration": "adaptive",
      "api_contract": "adaptive"
    },
    "cost_optimization": {
      "enabled": true
    },
    "human_cost": {
      "enabled": false,
      "hourly_rate_usd": 100.0
    },
    "compute_cost": {
      "enabled": true
    },
    "stop_loss": {
      "enabled": true,
      "max_cost_multiplier": 3.0,
      "max_retry_count": 3,
      "max_wall_time_minutes": null
    },
    "budget_enforcement": {
      "mode": "warn"
    },
    "risk_adjustment": {
      "enabled": true
    },
    "delayed_outcomes": {
      "enabled": true,
      "windows_days": [
        7,
        30,
        90
      ]
    },
    "maintainability": {
      "enabled": true,
      "track_rewrite_rate": true,
      "track_complexity_delta": true,
      "track_duplication": true
    },
    "production_feedback": {
      "enabled": false,
      "ingest_incidents": true,
      "ingest_rollbacks": true,
      "ingest_error_rates": true
    },
    "replanning": {
      "enabled": true
    },
    "branch_cancellation": {
      "enabled": true
    },
    "dependencies": {
      "auto_add": "ask",
      "auto_upgrade": "ask"
    },
    "auto_merge": {
      "enabled": false
    },
    "auto_deploy": {
      "enabled": false
    },
    "destructive_operations": {
      "mode": "deny"
    },
    "policy_recommendations": {
      "enabled": true
    },
    "auto_policy_tuning": {
      "enabled": false
    },
    "policy_simulation": {
      "enabled": true
    },
    "policy_canary": {
      "enabled": true,
      "percentage": 5.0
    },
    "auto_policy_promotion": {
      "enabled": false
    },
    "decision_explanations": {
      "enabled": true,
      "level": "concise"
    },
    "reproducible_routing": {
      "enabled": false
    }
  },
  "persistence": {
    "directory": "~/.local/state/coding-agent-orchestrator",
    "events": "events.jsonl",
    "metrics": "metrics.jsonl",
    "discoveries": "discoveries.jsonl",
    "outcomes": "outcomes.jsonl",
    "ledger": "ledger.json",
    "context_registry": "context_registry.json",
    "verification_cache": "verification_cache.json",
    "locks": "locks.json",
    "dashboard": "dashboard.html"
  }
}
